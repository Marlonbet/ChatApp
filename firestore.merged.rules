rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ChatBot: interacciones guardadas (existente) =====
    match /interactions/{docId} {
      allow create: if request.resource.data.keys().hasAll(['sessionId','userMessage','botResponse','createdAt'])
        && request.resource.data.userMessage is string
        && request.resource.data.userMessage.size() <= 500
        && request.resource.data.botResponse is string
        && request.resource.data.botResponse.size() <= 2000;
      allow read, update, delete: if false;
    }

    // ===== Arranque USA: datos por usuario (existente) =====
    match /arranque_users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ===== ChatApp: perfiles de usuario =====
    // Cualquier usuario autenticado puede buscar/leer perfiles (para encontrar contactos).
    // Solo el dueño puede crear/editar su propio perfil.
    match /chatapp_users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ===== ChatApp: chats 1 a 1 =====
    // Solo los participantes pueden ver o modificar el chat.
    // 'get' también permite comprobar si un chat aún no existe (para crearlo al iniciar conversación).
    // Al actualizar, la lista de participantes no puede cambiar.
    match /chatapp_chats/{chatId} {
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/chatapp_chats/$(chatId))
            || request.auth.uid in resource.data.participants);
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      // ===== ChatApp: mensajes =====
      // Solo los participantes del chat pueden leer.
      // Solo el autor puede crear mensajes (texto 1..2000 caracteres).
      // Los mensajes no se editan ni se borran.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chatapp_chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chatapp_chats/$(chatId)).data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // ===== Denegar todo lo demás =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
